<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:layout_marginBottom="16dp">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/activity_tracker_title"
                    android:layout_width="wrap_content"
                    android:layout_height="100dp"
                    android:layout_centerInParent="true"
                    android:background="@drawable/activity_back"
                    android:gravity="center"
                    android:text="Activity Tracker"
                    android:textColor="@android:color/white"
                    android:textSize="20sp"
                    android:textStyle="bold" />
            </RelativeLayout>

            <LinearLayout
                android:layout_marginLeft="15dp"
                android:layout_marginTop="10dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:textStyle="bold"
                    android:textSize="13sp"
                    android:id="@+id/day_month_year"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="[Day, Month, Year]" />

                <TextView
                    android:layout_marginLeft="5dp"
                    android:id="@+id/my_daily_progress"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="My Daily Progress -  Today, I:"
                    android:textStyle="bold"
                    android:textSize="13sp" />
            </LinearLayout>

            <CheckBox
                android:id="@+id/exercised_today"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Have exercised"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginLeft="30dp" />

            <CheckBox
                android:id="@+id/drank_water"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginLeft="30dp"
                android:text="Drank 8 cups of water" />

            <CheckBox
                android:id="@+id/medication_taken"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginLeft="30dp"
                android:text="Took my medication on time" />

            <CheckBox
                android:id="@+id/eaten_balanced_meal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginLeft="30dp"
                android:text="Ate a balanced meal" />

            <CheckBox
                android:id="@+id/avoided_sugary_foods"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginLeft="30dp"
                android:text="Avoided sugary foods" />

            <CheckBox
                android:id="@+id/daily"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginLeft="30dp"
                android:text="Did my daily checkups" />

            <CheckBox
                android:id="@+id/sleep_hours_checked"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginLeft="30dp"
                android:text="Got at least 7 hours of sleep" />

            <CheckBox
                android:id="@+id/screen_break_checked"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginLeft="30dp"
                android:text="Took a break from screens for eye health" />

            <LinearLayout
                android:layout_marginLeft="30dp"
                android:id="@+id/checkboxes_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="visible" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <ImageView
                    android:contentDescription="img happy"
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:layout_marginLeft="60dp"
                    android:src="@drawable/activity_happy" />

                <TextView
                    android:id="@+id/completion_message"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Great job! You've completed \n 8/8 tasks today!"
                    android:textSize="13sp"
                    android:layout_marginRight="10dp"
                    android:textStyle="bold"
                    android:layout_marginTop="16dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="50dp"
                android:layout_gravity="center"
                android:orientation="horizontal">

                <Button
                    android:minHeight="48dp"
                    android:id="@+id/track_another_activity"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_gravity="center"
                    android:layout_marginRight="10dp"
                    android:backgroundTint="@color/blue"
                    android:text="Add Activity"
                    android:textColor="@android:color/white"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    style="?android:attr/buttonBarButtonStyle" />

                <Button
                    android:id="@+id/done"
                    android:layout_width="80dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginRight="20dp"
                    android:backgroundTint="@color/blue"
                    android:text="Done"
                    android:textColor="@android:color/white"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    tools:ignore="TextSizeCheck"
                    style="?android:attr/buttonBarButtonStyle" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
