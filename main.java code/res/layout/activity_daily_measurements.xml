<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/l1"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:background="@color/blue">

        <TextView
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="Daily Measurements"
            android:textSize="20sp"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:gravity="center" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/l2"
        android:layout_below="@id/l1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="30dp"
        android:paddingStart="20dp"
        android:paddingEnd="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="What time do you want to be reminded of measuring BP?"
            android:textSize="15sp"
            android:textStyle="bold"
            android:gravity="center" />

        <Button
            android:id="@+id/pick_time"
            android:layout_width="wrap_content"
            android:layout_height="50dp"
            android:text="Pick Time"
            android:textSize="16dp"
            android:layout_gravity="center"
            android:layout_marginTop="5dp"
            android:backgroundTint="@color/blue"
            android:textColor="@color/white"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/time_section"
        android:layout_below="@id/l2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="20dp"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/text3"
            android:gravity="center"
            android:layout_gravity="center"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Time for reminder: 2:00pm"
            android:textSize="15sp" />


    </LinearLayout>

    <TextView
        android:id="@+id/text4"
        android:layout_below="@id/time_section"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Blood Pressure :"
        android:gravity="center"
        android:textStyle="bold"
        android:layout_marginTop="20dp"
        android:layout_marginStart="20dp"
        android:textSize="15sp" />

    <EditText
        android:id="@+id/button3"
        android:layout_below="@id/time_section"
        android:layout_width="90dp"
        android:layout_height="48dp"
        android:layout_marginTop="10dp"
        android:layout_toRightOf="@id/text4"
        android:hint="Systolic"
        android:enabled="true"
        android:gravity="center"
        android:textStyle="bold"
        android:backgroundTint="@color/black"
        android:textColor="@color/black" />
    <TextView
        android:textSize="22dp"
        android:layout_marginTop="20dp"
        android:layout_toRightOf="@id/button3"
        android:layout_below="@id/time_section"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textStyle="bold"
        android:text="/"/>
    <EditText
        android:enabled="true"
        android:id="@+id/dia"
android:layout_below="@id/time_section"        android:layout_width="90dp"
        android:layout_height="48dp"
        android:layout_marginTop="10dp"
        android:layout_toRightOf="@id/button3"
        android:hint="diastolic"
        android:gravity="center"
        android:textStyle="bold"
        android:backgroundTint="@color/black"
        android:textColor="@color/black" />

    <TextView
        android:textStyle="bold"
        android:layout_below="@id/button3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Glucose levels:"
        android:layout_marginTop="20dp"
        android:layout_marginStart="20dp"
        android:gravity="center"
        android:textSize="15sp" />

    <EditText
        android:id="@+id/glucose_levels"
        android:layout_below="@id/button3"
        android:layout_width="90dp"
        android:layout_height="48dp"
        android:layout_marginLeft="170dp"
        android:layout_marginTop="10dp"
        android:hint="0 (mg/dL)"
        android:gravity="center"
        android:textStyle="bold"
        android:textColor="@color/black"
        android:backgroundTint="@color/white" />

    <TextView
        android:layout_below="@id/glucose_levels"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Glucose was measured:"
        android:layout_marginTop="20dp"
        android:textStyle="bold"
        android:layout_centerHorizontal="true"
        android:textSize="15sp" />

    <RadioGroup
        android:id="@+id/radio_group"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/glucose_levels"
        android:layout_marginTop="45dp"
android:layout_marginLeft="25dp"        android:orientation="vertical">

        <RadioButton
            android:id="@+id/before_meal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Before meal"
            android:textSize="14sp"
            android:layout_marginEnd="30dp" />

        <RadioButton
            android:id="@+id/after_meal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="After meal"
            android:textSize="14sp"
            android:layout_marginBottom="10dp" />

        <!-- Second row -->
        <RadioButton
            android:id="@+id/fasting"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Fasting"
            android:textSize="14sp"
            android:layout_marginEnd="30dp" />

        <RadioButton
            android:id="@+id/none"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="None"
            android:textSize="14sp" />
    </RadioGroup>



    <Button
        android:id="@+id/update"
        android:layout_below="@id/radio_group"
        android:layout_width="wrap_content"
        android:layout_height="50dp"
        android:text="Update"
        android:textSize="16dp"
        android:layout_marginTop="5dp"
        android:layout_centerHorizontal="true"
        android:backgroundTint="@color/blue"
        android:textStyle="bold"
        android:textColor="@color/white" />
</RelativeLayout>
