<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
<LinearLayout
    android:layout_width="wrap_content"
    android:layout_height="100dp"
    android:background="@drawable/settings_page"></LinearLayout>
    <RelativeLayout android:layout_width="wrap_content" android:layout_height="wrap_content" >
        <TextView android:id="@+id/textView1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Enable Notifications" android:layout_marginLeft="20dp" android:textSize="20dp" android:textStyle="bold" android:layout_marginTop="40dp"/>
        <Switch android:id="@+id/notifications_switch" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="end" android:layout_marginLeft="300dp" android:layout_marginTop="40dp" tools:ignore="TouchTargetSizeCheck"/>
        <TextView android:id="@+id/textView2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Medication Reminders" android:layout_marginLeft="20dp" android:textSize="20dp" android:textStyle="bold" android:layout_marginTop="75dp"/>
        <Switch android:id="@+id/medication" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="end" android:layout_marginLeft="300dp" android:layout_marginTop="75dp" tools:ignore="TouchTargetSizeCheck"/>
        <TextView android:id="@+id/textView3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Appointment Reminders" android:layout_marginLeft="20dp" android:textSize="20dp" android:textStyle="bold" android:layout_gravity="end" android:layout_marginTop="105dp" tools:ignore="InvalidId"/>
        <Switch android:id="@+id/Appointment" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="end" android:layout_marginLeft="300dp" android:layout_marginTop="105dp" tools:ignore="TouchTargetSizeCheck"/>
        <TextView android:id="@+id/textview4" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Health Tips and Insights" android:layout_marginLeft="20dp" android:textStyle="bold" android:textSize="20dp" android:layout_marginTop="140dp"/>
        <Switch android:id="@+id/Health_Tips" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="end" android:layout_marginLeft="300dp" android:layout_marginTop="140dp" tools:ignore="TouchTargetSizeCheck"/>
        <TextView android:id="@+id/textView5" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Daily Vital Alerts" android:layout_marginLeft="20dp" android:textStyle="bold" android:textSize="20dp" android:layout_marginTop="170dp"/>
        <Switch android:id="@+id/Daily" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="end" android:layout_marginLeft="300dp" android:layout_marginTop="170dp" tools:ignore="TouchTargetSizeCheck"/>
        <ImageView android:layout_width="wrap_content" android:layout_height="wrap_content" android:src="@drawable/line" android:layout_below="@id/Daily" android:id="@+id/line" android:paddingTop="20dp" android:layout_marginLeft="20dp" android:layout_marginRight="20dp"/>
        <TextView android:id="@+id/textView6" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Switch to high contrast mode" android:layout_marginLeft="20dp" android:textStyle="bold" android:textSize="20dp" android:layout_below="@+id/line" android:layout_marginTop="40dp"/>
        <Switch android:id="@+id/switch1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_below="@id/line" android:layout_gravity="end" android:layout_marginLeft="300dp" android:layout_marginTop="40dp" tools:ignore="TouchTargetSizeCheck"/>
        <ImageView android:layout_width="wrap_content" android:layout_height="wrap_content" android:src="@drawable/line" android:layout_below="@id/switch1" android:id="@+id/line2" android:paddingTop="20dp" android:layout_marginLeft="20dp" android:layout_marginRight="20dp"/>
        <TextView  android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Choose the Language" android:layout_marginLeft="20dp" android:textStyle="bold" android:textSize="20dp" android:layout_below="@+id/line" android:layout_marginTop="130dp"/>
        <Spinner android:id="@+id/language_spinner2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginLeft="270dp" android:layout_marginTop="350dp" tools:ignore="TouchTargetSizeCheck"/>
        <TextView android:id="@+id/textview8" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Adjust Font Size" android:layout_marginTop="430dp" android:layout_marginLeft="20dp" android:textStyle="bold" android:textSize="20dp"/>
        <SeekBar
            android:id="@+id/font_size_seekbar"
            android:layout_width="200dp"
            android:layout_height="60dp"
            android:layout_marginLeft="270dp"
            android:layout_marginTop="420dp"
            android:max="100"
            android:min="0" />

        <Button android:id="@+id/update_button5" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Update" android:textSize="20dp" android:layout_marginLeft="160dp" android:backgroundTint="#5B5B5B" android:layout_marginTop="520dp"/>
    </RelativeLayout>
</LinearLayout>